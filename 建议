    PRECOMPILED_TASKS = {
        "s3_logic_review": {
            "instruction_type": "structured_review",
            "dimensions": ["logic", "consistency", "causality"],
            "output_format": "json",
            "required_fields": ["verdict", "score", "issues", "fixes"]
        },
        "s4_fingerprint_detect": {
            "instruction_type": "pattern_matching",
            "patterns": ["ai_words", "syntax_repeat", "style_drift"],
            "output_format": "json",
            "thresholds": {"ai_words": 0.05, "syntax_repeat": 3}
        },
        "chapter_writing": {
            "instruction_type": "creative_generation",
            "constraints": ["style_anchor", "beat_position", "hook_required"],
            "output_format": "markdown"
        }
    }
    
    def precompile(self, task_type: str, params: Dict) -> PrecompiledTask:
        """
        返回预编译的任务模板，减少运行时Prompt长度
        """
        template = self.PRECOMPILED_TASKS[task_type]
        
        # 只填充动态参数
        compiled = {
            "type": template["instruction_type"],
            "static": template,  # 预编译部分，不占Token
            "dynamic": params    # 动态部分，占Token
        }
        
        return PrecompiledTask(
            compiled=compiled,
            token_estimate=len(json.dumps(params)) // 4  # 粗略估计
        )
