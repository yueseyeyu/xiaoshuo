```python
# 新增：s4_layers/content_redundancy_detector.py

class ContentRedundancyDetector:
    """
    检测内容冗长和重复
    
    核心假设：AI生成内容常存在信息冗余和情节重复
    """
    
    def analyze(self, text: str) -> RedundancyReport:
        """
        检测冗余和重复
        
        检测维度：
        1. 信息密度（每千字传递的新信息量）
        2. 情节重复（相同或相似情节出现次数）
        3. 对话重复（相同对话模式重复）
        4. 描写重复（相同环境/外貌描写重复）
        5. 语义重复（相邻段落表达相同意思）
        """
        
        # 1. 信息密度
        info_density = self._compute_info_density(text)
        # 方法：提取实体+事件，计算每千字新信息数
        
        # 2. 情节重复
        plot_repetition = self._detect_plot_repetition(text)
        # 方法：提取情节摘要，用相似度检测重复
        
        # 3. 对话重复
        dialogue_repetition = self._detect_dialogue_repetition(text)
        # 方法：提取对话模式，检测"复读机"现象
        
        # 4. 描写重复
        description_repetition = self._detect_description_repetition(text)
        # 方法：提取环境/外貌描写，检测相同意象
        
        # 5. 语义重复
        semantic_repetition = self._detect_semantic_repetition(text)
        # 方法：相邻段落embedding相似度
        
        return RedundancyReport(
            info_density=info_density,
            plot_repetition=plot_repetition,
            dialogue_repetition=dialogue_repetition,
            description_repetition=description_repetition,
            semantic_repetition=semantic_repetition,
            overall_score=self._compute_score(...),
            fix_suggestions=self._generate_fixes(...)
        )
    
    def _detect_semantic_repetition(self, text: str) -> SemanticRepetitionReport:
        """
        检测语义重复（相邻段落说同一件事）
        
        使用embedding相似度
        """
        paragraphs = self._split_paragraphs(text)
        
        repetitions = []
        for i in range(len(paragraphs) - 1):
            sim = self._semantic_similarity(paragraphs[i], paragraphs[i+1])
            if sim > 0.85:  # 阈值
                repetitions.append({
                    "position": i,
                    "similarity": sim,
                    "para1": paragraphs[i][:50],
                    "para2": paragraphs[i+1][:50]
                })
        
        return SemanticRepetitionReport(
            count=len(repetitions),
            rate=len(repetitions) / len(paragraphs) if paragraphs else 0,
            examples=repetitions[:3]
        )
    
    def _generate_fixes(self, report: RedundancyReport) -> List[str]:
        fixes = []
        
        if report.info_density < 5:  # 每千字<5个新信息
            fixes.append(
                "【信息密度过低】每千字仅{}个新信息，内容冗长。\n"
                "建议：删除以下类型的冗余内容：\n"
                "- 重复的世界观说明\n"
                "- 无新信息的对话\n"
                "- 过度详细的环境描写\n"
                "- 已知的角色心理活动".format(report.info_density)
            )
        
        if report.semantic_repetition.rate > 0.1:
            fixes.append(
                "【语义重复】{}%的相邻段落语义相似度>0.85。\n"
                "建议：合并或删除以下重复段落：\n{}".format(
                    report.semantic_repetition.rate * 100,
                    self._format_examples(report.semantic_repetition.examples)
                )
            )
        
        return fixes
