### 1. 设定清晰度检测（对应"剧情与人物设定模糊"）

```python
# 新增：s4_layers/setting_clarity_detector.py

class SettingClarityDetector:
    """
    检测剧情和人物设定的清晰度
    
    核心假设：清晰的设定 = 可回答5W1H的问题
    """
    
    def analyze(self, manuscript: Manuscript, canon: Canon) -> ClarityReport:
        """
        分析前10章的设定清晰度
        
        检测维度：
        1. 人物档案完整性（Canon覆盖率）
        2. 剧情逻辑链完整性（因果可追溯）
        3. 世界观一致性（无自相矛盾）
        4. 动机明确度（主角行为有解释）
        """
        
        # 1. 人物档案完整性
        character_coverage = self._check_character_coverage(manuscript, canon)
        # 检测：每个出场角色是否在Canon中有档案
        # 阈值：出场角色覆盖率 > 80%
        
        # 2. 剧情逻辑链
        logic_chain = self._check_logic_chain(manuscript)
        # 检测：每个事件是否有"因为...所以..."的因果链
        # 阈值：逻辑断裂点 < 3处/10章
        
        # 3. 世界观一致性
        world_consistency = self._check_world_consistency(manuscript, canon)
        # 检测：世界观设定（修炼体系/社会规则）是否前后一致
        # 阈值：矛盾点 = 0
        
        # 4. 动机明确度
        motivation_clarity = self._check_motivation(manuscript, canon)
        # 检测：主角每个重大行为是否有明确动机支撑
        # 阈值：动机不明行为 < 2处/10章
        
        return ClarityReport(
            character_coverage=character_coverage,
            logic_chain=logic_chain,
            world_consistency=world_consistency,
            motivation_clarity=motivation_clarity,
            overall_score=self._compute_score(...),
            verdict=self._verdict(...),
            fix_suggestions=self._generate_fixes(...)
        )
    
    def _check_character_coverage(self, manuscript: Manuscript, canon: Canon) -> float:
        """
        检测出场角色在Canon中的覆盖率
        """
        characters_in_text = self._extract_characters(manuscript.text)
        characters_in_canon = set(canon.characters.keys())
        
        covered = len(characters_in_text & characters_in_canon)
        total = len(characters_in_text)
        
        return covered / total if total > 0 else 1.0
    
    def _check_logic_chain(self, manuscript: Manuscript) -> LogicChainReport:
        """
        检测剧情逻辑链的完整性
        
        方法：提取所有事件，检查是否有因果连接
        """
        events = self._extract_events(manuscript.text)
        
        breaks = []
        for i in range(len(events) - 1):
            if not self._has_causal_link(events[i], events[i+1]):
                breaks.append({
                    "position": i,
                    "event1": events[i],
                    "event2": events[i+1],
                    "issue": "事件之间缺乏因果连接"
                })
        
        return LogicChainReport(
            total_events=len(events),
            breaks=breaks,
            break_rate=len(breaks) / len(events) if events else 0
        )
    
    def _generate_fixes(self, report: ClarityReport) -> List[str]:
        fixes = []
        
        if report.character_coverage < 0.8:
            fixes.append(
                "【人物设定模糊】出场角色中{}%无Canon档案。\n"
                "建议：为以下角色补充档案：{}\n"
                "档案应包含：原生环境、性格、目标、软肋、反差萌".format(
                    (1-report.character_coverage)*100,
                    self._get_uncovered_characters()
                )
            )
        
        if report.logic_chain.break_rate > 0.2:
            fixes.append(
                "【剧情逻辑断裂】{}%的事件缺乏因果连接。\n"
                "建议：在以下位置补充过渡：\n{}".format(
                    report.logic_chain.break_rate*100,
                    self._format_breaks(report.logic_chain.breaks)
                )
            )
        
        return fixes
```

### 2. 作者风格偏离度检测（对应"过度依赖Agent导致风格丢失"）

```python
# 新增：s4_layers/author_style_deviation_detector.py

class AuthorStyleDeviationDetector:
    """
    检测AI生成内容是否偏离作者个人风格
    
    核心假设：每个作者有独特的风格指纹，AI生成应保持或增强该风格
    """
    
    def __init__(self, author_profile: AuthorProfile):
        self.author_fingerprint = author_profile.style_fingerprint
        # 包含：平均句长、对话占比、感官词密度、心理前缀密度、
        #       常用句式、口头禅、偏好修辞等
    
    def analyze(self, draft: str) -> StyleDeviationReport:
        """
        对比AI生成稿与作者风格指纹的差异
        
        检测维度：
        1. 句长分布偏离度
        2. 对话占比偏离度
        3. 感官词密度偏离度
        4. 句式多样性偏离度
        5. 口头禅出现率
        6. 修辞偏好偏离度
        """
        
        draft_fingerprint = self._extract_fingerprint(draft)
        
        deviations = {}
        for key in self.author_fingerprint:
            if key in draft_fingerprint:
                deviations[key] = abs(
                    draft_fingerprint[key] - self.author_fingerprint[key]
                ) / self.author_fingerprint[key]  # 相对偏离度
        
        # 综合偏离度
        overall_deviation = np.mean(list(deviations.values()))
        
        return StyleDeviationReport(
            deviations=deviations,
            overall_deviation=overall_deviation,
            verdict="BLOCK" if overall_deviation > 0.5 else "WARNING" if overall_deviation > 0.3 else "PASS",
            fix_suggestions=self._generate_fixes(deviations)
        )
    
    def _generate_fixes(self, deviations: Dict[str, float]) -> List[str]:
        fixes = []
        
        if deviations.get("avg_sentence_length", 0) > 0.3:
            fixes.append(
                "【句长偏离】作者习惯{}字/句，当前{}字/句。\n"
                "建议：调整句式，{}。".format(
                    self.author_fingerprint["avg_sentence_length"],
                    self.author_fingerprint["avg_sentence_length"] * (1+deviations["avg_sentence_length"]),
                    "缩短句子" if deviations["avg_sentence_length"] > 0 else "增加长句"
                )
            )
        
        if deviations.get("dialogue_ratio", 0) > 0.3:
            fixes.append(
                "【对话占比偏离】作者习惯{}%对话，当前{}%。\n"
                "建议：{}对话比例。".format(
                    self.author_fingerprint["dialogue_ratio"]*100,
                    (self.author_fingerprint["dialogue_ratio"] * (1+deviations["dialogue_ratio"]))*100,
                    "增加" if deviations["dialogue_ratio"] < 0 else "减少"
                )
            )
        
        return fixes
