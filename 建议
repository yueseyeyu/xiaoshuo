### 3. 冲突质量评估（对应"不擅长处理冲突与转折"）

```python
# 新增：s4_layers/conflict_quality_detector.py

class ConflictQualityDetector:
    """
    检测冲突和转折的质量
    
    核心假设：高质量冲突 = 有 stakes + 有转折 + 有升级 + 有代价
    """
    
    def analyze(self, chapters: List[str]) -> ConflictQualityReport:
        """
        分析前10章的冲突质量
        
        检测维度：
        1. 冲突 stakes（主角损失什么）
        2. 冲突转折（是否有意外发展）
        3. 冲突升级（是否逐步加剧）
        4. 冲突代价（主角是否付出代价）
        5. 冲突解决（是否过于轻易）
        """
        
        conflicts = self._extract_conflicts(chapters)
        
        quality_scores = []
        for conflict in conflicts:
            score = 0
            
            # stakes
            if conflict.has_stakes:
                score += 2
            
            # 转折
            if conflict.has_twist:
                score += 2
            
            # 升级
            if conflict.has_escalation:
                score += 2
            
            # 代价
            if conflict.has_cost:
                score += 2
            
            # 解决难度
            if not conflict.too_easy_resolution:
                score += 2
            
            quality_scores.append({
                "conflict": conflict.summary,
                "score": score,
                "max": 10
            })
        
        avg_score = sum(s["score"] for s in quality_scores) / len(quality_scores) if quality_scores else 0
        
        return ConflictQualityReport(
            conflicts=quality_scores,
            avg_score=avg_score,
            verdict="BLOCK" if avg_score < 4 else "WARNING" if avg_score < 6 else "PASS",
            fix_suggestions=self._generate_fixes(quality_scores)
        )
    
    def _generate_fixes(self, scores: List[Dict]) -> List[str]:
        fixes = []
        
        low_conflicts = [s for s in scores if s["score"] < 5]
        if low_conflicts:
            fixes.append(
                "【冲突质量不足】检测到{}个低质量冲突（均分{}/10）。\n"
                "常见问题：\n"
                "- 缺乏stakes（主角没有真正损失）\n"
                "- 缺乏转折（读者能猜到结局）\n"
                "- 缺乏升级（冲突强度不变）\n"
                "- 缺乏代价（主角轻松获胜）\n"
                "建议：为每个冲突增加至少2个维度。".format(
                    len(low_conflicts),
                    sum(s["score"] for s in low_conflicts) / len(low_conflicts)
                )
            )
        
        return fixes
